Cell[BoxData[
 RowBox[{
  RowBox[{"subpert", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Psi]", "[", "u", "]"}], "\[Rule]", 
      RowBox[{
       RowBox[{"u", " ", "\[Pi]"}], "+", 
       RowBox[{"\[Epsilon]", " ", 
        RowBox[{"\[Delta]\[Psi]", "[", 
         RowBox[{"u", ",", "t"}], "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Psi]", "'"}], "[", "u", "]"}], "\[Rule]", " ", 
      RowBox[{"\[Pi]", "+", 
       RowBox[{"\[Epsilon]", " ", 
        RowBox[{
         SuperscriptBox["\[Delta]\[Psi]", 
          TagBox[
           RowBox[{"(", 
